{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 14,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "release",
			"displayName": "Release build of the Ayna runners",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"DRAMPOWER_BUILD_CLI": "ON"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug build with warnings",
			"inherits": "release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic"
			}
		}
	],
	"buildPresets": [
		{
			"name": "release",
			"configurePreset": "release",
			"targets": ["HBM2_runner", "HBM3_runner"]
		}
	]
}
